<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SerialDebugger.ByteVisualizerWindow"
        Title="SerialDebugger — Byte Visualizer"
        Width="1060" Height="420"
        Background="#1E1E1E">

	<Grid Margin="14" RowDefinitions="Auto,*">

		<!-- Header Banner -->
		<Border Grid.Row="0" BorderBrush="#444444" BorderThickness="1" Background="#252526" Padding="14,10" Margin="0,0,0,10">
			<Grid ColumnDefinitions="*,Auto">
				<TextBlock x:Name="TxtHeader" Grid.Column="0"
                           Text="Visualizing: Waiting for traffic... (0 bytes)"
                           Foreground="#00A2FF" FontWeight="Bold" FontSize="15"
                           VerticalAlignment="Center"/>
				<StackPanel Grid.Column="1" Orientation="Horizontal">
					<CheckBox x:Name="ChkPause" Content="Freeze" Foreground="#E0E0E0" Margin="0,0,12,0" VerticalAlignment="Center"/>
					<Button Content="Clear" Width="72" Background="#3F3F46" Foreground="#F1F1F1" BorderBrush="#555555" Click="BtnClear_Click"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- Horizontally Scrollable Black Waveform Canvas -->
		<Border Grid.Row="1" BorderBrush="#444444" BorderThickness="1" Background="#050505">
			<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
				<Canvas x:Name="WaveCanvas" Background="#050505" Width="900" Height="295"/>
			</ScrollViewer>
		</Border>
	</Grid>
</Window>